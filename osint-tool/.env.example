# NEXUS OSINT Console — environment configuration
# Copy to .env. The tool is built to run 100% FREE: nothing below needs money.
# Every paid key is optional; when it is empty that source is skipped quietly
# and a free source already covers the same job.

# --- Access control (ROADMAP 8.4) ---
# If set, every /api/* request must send header  X-API-Key: <value>.
# Its holder is "admin": reads the audit log and may delete all data.
# Use 16+ random characters, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
OSINT_API_KEY=
# Named keys, so the audit log records who searched:  alice:<key>,bob:<key>
OSINT_USERS=
# With no key at all the API answers only this machine and private networks;
# a request from a public address gets 403. Set 1 to expose it without a key
# (not recommended). Behind a reverse proxy on the same host, always set a key.
ALLOW_OPEN_ACCESS=

# --- Audit log (ROADMAP 8.3) ---
# Who searched what and when, kept locally in the cases database.
AUDIT_RETENTION_DAYS=90
# 0 = keep only a SHA-256 of each search term instead of the term itself
AUDIT_LOG_QUERIES=1

# Browser origins allowed to call the API (CORS). Comma-separated.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ============ FREE (recommended) ============
# GitHub API token — free, no scopes needed: https://github.com/settings/tokens
# Lifts the limit from 60 to 5000 requests/hour. Sent ONLY to api.github.com.
GITHUB_TOKEN=
# UK Companies House — free key after a free sign-up (no card):
# https://developer.company-information.service.gov.uk/  (UK companies + officers)
COMPANIES_HOUSE_API_KEY=
# Our own SearXNG search container. Any random string:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=
# SEARXNG_URL=http://searxng:8080   (default; empty disables SearXNG)
# Holehe login-form checks (amazon, yahoo, ebay... 13 sites). Off by default:
# a login check may send the address owner a failed-login alert.
HOLEHE_ALLOW_LOGIN=
# Adult-site registration checks (special-category data). Off by default.
HOLEHE_INCLUDE_ADULT=

# ============ OPTIONAL PAID / LIMITED — leave empty ============
# Each line names the free source that already does this job without a key.
# Breach check. Free replacement: XposedOrNot (built in).
HIBP_API_KEY=
# Web search. Free replacement: SearXNG (built in).
BRAVE_API_KEY=
# Subdomains. Free replacement: Subfinder + crt.sh + HackerTarget (built in).
SECURITYTRAILS_API_KEY=
# Company emails. Free replacement: "Published emails" search (built in).
# (hunter.io has a small free monthly plan if you want it.)
HUNTER_API_KEY=
# Company registry. Free replacement: GLEIF + SEC EDGAR (built in).
OPENCORPORATES_API_KEY=
# Sanctions/PEP screening. No built-in free replacement yet.
OPENSANCTIONS_API_KEY=

# --- Local AI (Ollama + Qwen) ---
# The browser calls Ollama directly, so this URL must be reachable from YOUR
# browser (not the container). Default is the local Ollama.
OLLAMA_URL=http://127.0.0.1:11434
# Text model for "AI Summary" (pull it: ollama pull qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:7b
# Vision model for "AI Vision" (pull it later: ollama pull qwen2.5vl:7b | llava | moondream)
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# --- Infrastructure ---
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=900

# --- Rate limits (per IP) ---
RATE_LIMIT_HEAVY=4/minute
RATE_LIMIT_LIGHT=15/minute
RATE_LIMIT_GENERAL=60/minute
RATE_LIMIT_POLL=120/minute

# --- Worker ---
WORKER_MAX_JOBS=4
WORKER_JOB_TIMEOUT=1200
WORKER_KEEP_RESULT=3600
