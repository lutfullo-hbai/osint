# NEXUS OSINT Console — environment configuration
# Copy to .env and fill what you need. Every key is OPTIONAL:
# a tool whose key is missing is simply skipped (with a note), never broken.

# --- Access control ---
# If set, every /api/* request must send header  X-API-Key: <value>
# Leave empty for open local use. /health stays open.
OSINT_API_KEY=

# Browser origins allowed to call the API (CORS). Comma-separated.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Optional data-source API keys (skipped when empty) ---
# Email breach check — https://haveibeenpwned.com/API/Key (paid)
HIBP_API_KEY=
# Sanctions / PEP screening (Name) — https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=
# Company registry search (Company) — https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_KEY=

# --- Infrastructure ---
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=900

# --- Rate limits (per IP) ---
RATE_LIMIT_HEAVY=4/minute
RATE_LIMIT_LIGHT=15/minute
RATE_LIMIT_GENERAL=60/minute
RATE_LIMIT_POLL=120/minute

# --- Worker ---
WORKER_MAX_JOBS=4
WORKER_JOB_TIMEOUT=1200
WORKER_KEEP_RESULT=3600
